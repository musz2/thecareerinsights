---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PageHero from "./PageHero.astro";
import CtaBand from "./CtaBand.astro";
import Icon from "./Icon.astro";
import { solutionLinks } from "../data/site";

interface Benefit { title: string; copy: string; icon?: ImageMetadata }
interface Props {
  title: string;
  subtitle: string;
  intro: string;
  body: string;
  bullets: string[];
  stat: string;
  statLabel: string;
  benefits: Benefit[];
  hero: ImageMetadata;
  photo: ImageMetadata;
  photoAlt: string;
}

const { title, subtitle, intro, body, bullets, stat, statLabel, benefits, hero, photo, photoAlt } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, "");
const related = solutionLinks.filter((item) => item.href !== current);
---

<PageHero eyebrow="Solutions" title={title} copy={subtitle} image={hero} crumbs={[{ label: "Solutions", href: "/solutions" }]}>
  <div class="button-row"><a class="button button-red" href="/contact">Meet with an expert <Icon name="arrow" /></a></div>
</PageHero>

<section class="section">
  <div class="shell split top">
    <div class="split-copy" data-reveal>
      <p class="eyebrow">Overview</p>
      <h2>{intro}</h2>
      <p>{body}</p>
      <ul class="check-list">{bullets.map((bullet) => <li>{bullet}</li>)}</ul>
    </div>
    <div class="split-media" data-reveal>
      <div class="media-frame" data-parallax><Image src={photo} alt={photoAlt} widths={[480, 720, 1000]} sizes="(max-width: 960px) 92vw, 560px" format="webp" quality={80} loading="lazy" /></div>
    </div>
  </div>
</section>

<section class="section section-gray">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">Program value</p><h2>Built for measurable workforce outcomes.</h2></div>
      <p>What changes for your hiring team when the program is running.</p>
    </div>
    <div class="benefit-grid">
      {benefits.map((benefit) => (
        <article data-reveal>
          {benefit.icon && <Image src={benefit.icon} alt="" width={104} height={104} format="webp" quality={90} loading="lazy" />}
          <h3>{benefit.title}</h3>
          <p>{benefit.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="highlight" data-reveal>
      <strong>{stat}</strong>
      <p>{statLabel}</p>
    </div>
  </div>
</section>

<section class="section section-gray">
  <div class="shell">
    <div class="section-heading" data-reveal><div><p class="eyebrow">Related</p><h2>Explore other solutions.</h2></div></div>
    <div class="solution-grid cols-3">
      {related.map((item, index) => (
        <a class="solution-card" href={item.href} data-reveal>
          <span class="num">{String(index + 1).padStart(2, "0")}</span>
          <h3>{item.label}</h3>
          <p>{item.copy}</p>
          <span class="text-link">Learn more <Icon name="arrow" /></span>
        </a>
      ))}
      <a class="solution-card" href="/services" data-reveal>
        <span class="num">{String(related.length + 1).padStart(2, "0")}</span>
        <h3>Areas of Expertise</h3>
        <p>Specialist capability across analytics, AI/ML, SAP, cloud, cybersecurity, and application development.</p>
        <span class="text-link">Learn more <Icon name="arrow" /></span>
      </a>
    </div>
  </div>
</section>

<CtaBand />
