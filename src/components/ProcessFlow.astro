---
/* Recruiting & staffing process: three steps on concentric rings, joined by
   connector curves that draw in as the section scrolls; each step lights up
   in turn. Stacks into a vertical timeline on small screens. */
const steps = [
  { title: "Discover", copy: "We start with your critical requirement — role, skills, clearance, and timeline.", icon: "search" },
  { title: "Verify", copy: "Targeted database filtering and stringent checks of certifications and clearances.", icon: "shield" },
  { title: "Deploy", copy: "Qualified, vetted talent placed fast — and supported well beyond day one.", icon: "brief" }
];
---

<section class="section process" data-process aria-labelledby="process-title">
  <div class="shell">
    <div class="process-head" data-reveal>
      <p class="eyebrow">How we work</p>
      <h2 id="process-title">Our recruiting &amp; staffing <span>process.</span></h2>
    </div>
    <div class="process-stage">
      <svg class="process-rings" viewBox="0 0 640 640" aria-hidden="true">
        {[318, 262, 206, 150].map((r) => <circle cx="320" cy="320" r={r} />)}
      </svg>
      <svg class="process-links" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
        <path data-process-link d="M222 100 C 300 22, 380 22, 452 100" />
        <path data-process-link d="M548 100 C 620 178, 700 178, 778 100" />
      </svg>
      <ol class="process-steps">
        {steps.map((step, index) => (
          <li class="process-step" data-process-step>
            <span class="process-icon" aria-hidden="true">
              {step.icon === "search" && <svg viewBox="0 0 24 24"><circle cx="10" cy="8" r="4" /><path d="M3 20c0-3.3 3.1-6 7-6M15.5 17.5l3 3" /><circle cx="14" cy="15.5" r="2.6" /></svg>}
              {step.icon === "shield" && <svg viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.2 7.5 9.5 4.3-1.3 7.5-4.9 7.5-9.5V6Z" /><path d="m8.8 12.2 2.3 2.3 4.3-4.6" /></svg>}
              {step.icon === "brief" && <svg viewBox="0 0 24 24"><rect x="3.5" y="7.5" width="17" height="12" rx="2" /><path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5M3.5 12.5h17" /><path d="M12 11.5v2.2" /></svg>}
            </span>
            <span class="process-num">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
