---
import { contactInfo, solutionLinks } from "../data/site";
import LogoMark from "./LogoMark.astro";
import Icon from "./Icon.astro";

const navItems = [
  { label: "Industries", href: "/industries" },
  { label: "Expertise", href: "/services" },
  { label: "Leadership", href: "/leadership" },
  { label: "About", href: "/about" }
];

/* A link is current when the path matches or the page lives under it
   (e.g. /solutions/rpo highlights "Solutions"). */
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, "") || "/";
  if (target === "/") return pathname === "/";
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="shell nav-bar">
    <a class="brand" href="/" aria-label="The Career Insights home"><LogoMark /></a>

    <nav class="primary-nav" aria-label="Primary">
      <div class="nav-item" data-dropdown>
        <a
          class:list={["nav-link", { "is-current": isCurrent("/solutions") }]}
          href="/solutions"
          aria-haspopup="true"
          aria-expanded="false"
          aria-current={isCurrent("/solutions") ? "page" : undefined}
          data-dropdown-trigger
        >Solutions <Icon name="chevron" /></a>
        <div class="dropdown" data-dropdown-panel>
          {solutionLinks.map((item) => (
            <a href={item.href}>{item.label}<small>{item.tagline}</small></a>
          ))}
          <a href="/solutions">All solutions<small>Compare our talent models</small></a>
        </div>
      </div>
      {navItems.map((item) => (
        <div class="nav-item">
          <a
            class:list={["nav-link", { "is-current": isCurrent(item.href) }]}
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >{item.label}</a>
        </div>
      ))}
    </nav>

    <div class="nav-actions">
      <a class="button button-red nav-cta" href="/contact">Contact us</a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <i></i><i></i><i></i>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu data-lenis-prevent aria-hidden="true">
  <div class="shell">
    <nav aria-label="Mobile">
      <a class="m-link" href="/solutions" aria-current={isCurrent("/solutions") ? "page" : undefined}>Solutions</a>
      <div class="m-sub">
        {solutionLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      {navItems.map((item) => (
        <a class="m-link" href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a class="m-link" href="/contact" aria-current={isCurrent("/contact") ? "page" : undefined}>Contact</a>
    </nav>
    <a class="button button-red" href="/contact">Start a conversation</a>
    <div class="m-foot">
      <a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a>
      <a href={`tel:${contactInfo.deskTel}`}>{contactInfo.desk}</a>
      <span>{contactInfo.hours}</span>
    </div>
  </div>
</div>
