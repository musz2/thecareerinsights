---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { expertise, serviceGroups } from "../data/site";
import heroImage from "../assets/images/site/photo-tech-network.jpg";

/* Map each expertise summary to the matching detailed service section. */
const anchorFor = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes("analytics")) return "analytics";
  if (t.includes("sap")) return "sap";
  if (t.includes("cloud")) return "cloud";
  if (t.includes("cyber")) return "cybersecurity";
  if (t.includes("application")) return "applications";
  if (t.includes("public") || t.includes("university")) return "public-sector";
  return "workforce";
};
---

<BaseLayout title="Technology and Professional Services | The Career Insights" description="Analytics, AI/ML, SAP, cloud, cybersecurity, workforce, and application development services.">
  <PageHero eyebrow="Areas of expertise" title="Technology expertise built to deliver." copy="Specialist talent and consulting capability across the systems shaping modern business." image={heroImage} />

  <section class="section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">What we do</p><h2>Eight practices. One delivery standard.</h2></div>
        <p>We strengthen core capability and optimize delivery to produce scalable, high-value outcomes.</p>
      </div>
      <div class="expertise-index">
        {expertise.map((item) => (
          <a href={`#${anchorFor(item.title)}`}>
            <span>{item.code}</span>
            <h3>{item.title}</h3>
            <p>{item.capabilities.join(" · ")}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {serviceGroups.map((group, index) => (
    <section class:list={["section service-group", { "section-gray": index % 2 === 0 }]} id={group.id}>
      <div class="shell">
        <div class="service-head" data-reveal>
          <div><p class="eyebrow">{group.eyebrow}</p><h2>{group.title}</h2></div>
          <p>{group.intro}</p>
        </div>
        <div class="service-columns">
          {group.columns.map((column) => (
            <article data-reveal>
              <h3>{column.title}</h3>
              <ul>{column.items.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section section-dark" id="public-sector">
    <div class="shell split top">
      <div data-reveal>
        <p class="eyebrow light">Public sector and university</p>
        <h2>Capability for mission, learning, and public impact.</h2>
      </div>
      <div class="split-copy" data-reveal>
        <p class="lead">TCI supports public-sector programs, government contractors, universities, and workforce initiatives with verified talent and adaptable delivery.</p>
        <p>Services include clearance-aware recruiting, campus programs, technical training, employability pathways, staff augmentation, project teams, and public-sector readiness.</p>
        <div class="button-row"><a class="button button-red" href="/contact">Discuss your program</a></div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
