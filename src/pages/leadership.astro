---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import LeadershipShowcase from "../components/LeadershipShowcase.astro";
import CtaBand from "../components/CtaBand.astro";
import heroImage from "../assets/images/site/photo-open-office.webp";
---

<BaseLayout title="Leadership | The Career Insights" description="Meet the leadership behind The Career Insights — guiding talent solutions, workforce strategy, business development, operations, and client success.">
  <PageHero eyebrow="Leadership" title="Meet the team behind The Career Insights." copy="Guiding talent solutions, workforce strategy, and business growth with experience, trust, and execution." image={heroImage} />

  <LeadershipShowcase />

  <section class="section section-gray">
    <div class="shell split top">
      <div data-reveal>
        <p class="eyebrow">Leadership message</p>
        <h2>Experience, trust, and execution at every stage.</h2>
      </div>
      <div class="split-copy" data-reveal>
        <p class="lead">Our leadership team brings together experience in talent acquisition, workforce planning, business development, and professional training.</p>
        <p>We focus on helping companies find the right talent while supporting professionals in building future-ready careers.</p>
        <ul class="check-list">
          <li>Client-first partnerships</li>
          <li>Reliable delivery</li>
          <li>Future-ready professionals</li>
        </ul>
      </div>
    </div>
  </section>

  <CtaBand title="Build a workforce plan with the team behind the vision." />
</BaseLayout>
