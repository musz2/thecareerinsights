---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import IndustryGrid from "../components/IndustryGrid.astro";
import RegionDivider from "../components/RegionDivider.astro";
import CtaBand from "../components/CtaBand.astro";
import { industries } from "../data/site";
import heroImage from "../assets/images/site/photo-workforce.webp";

const descriptions = [
  "Digital talent for infrastructure, platforms, software, data, security, and transformation.",
  "Cleared specialists and program talent for complex, mission-critical environments.",
  "Verified, compliant talent for government agencies, contractors, and public programs.",
  "Clinical, operational, technology, analytics, and support talent for evolving care systems.",
  "Engineering, field, digital, data, and operational capability for critical infrastructure.",
  "Campus recruitment, employability, learning programs, and workforce-ready talent pathways.",
  "Specialized engineering, manufacturing, supply-chain, software, and technical talent.",
  "Risk, analytics, technology, compliance, operations, and customer talent for financial firms.",
  "Product, platform, media, telecom, cloud, data, and creative technology capability.",
  "Engineering, automation, operations, supply-chain, quality, and digital manufacturing talent.",
  "Creative, production, technology, data, live operations, and product specialists.",
  "Network, cloud, security, infrastructure, customer, and transformation expertise."
];
---

<BaseLayout title="Industries | The Career Insights" description="Talent strategies for technology, public sector, healthcare, energy, education, finance, manufacturing, and more.">
  <PageHero eyebrow="Industries" title="Your industry's challenges. Our talent strategy." copy="We bring sector context and flexible workforce programs to the operating realities behind every role." image={heroImage} />

  <section class="section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Featured sectors</p><h2>Built for your industry and your future.</h2></div>
        <p>Every industry faces different regulatory pressures, skills gaps, growth cycles, and transformation demands. We adapt the talent strategy to your world.</p>
      </div>
      <IndustryGrid />
    </div>
  </section>

  <section aria-labelledby="regions-title">
    <div class="shell">
      <h2 class="sr-only" id="regions-title">Regions we recruit across</h2>
      <RegionDivider />
    </div>
  </section>

  <section class="section section-gray">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">All sectors</p><h2>Where we place talent.</h2></div>
        <p>Beyond our featured sectors, TCI supports hiring across twelve industries.</p>
      </div>
      <div class="sector-list">
        {industries.map((industry, index) => (
          <article data-reveal><h3>{industry}</h3><p>{descriptions[index]}</p></article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Hiring in a specialist sector?" copy="Tell us about the roles and the regulatory context. We'll come back with a sourcing plan." />
</BaseLayout>
