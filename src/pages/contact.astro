---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { contactInfo } from "../data/site";
import heroImage from "../assets/images/site/hero-background.webp";
---

<BaseLayout title="Contact The Career Insights" description="Tell The Career Insights about your staffing, talent, technology, or career needs.">
  <PageHero eyebrow="Contact us" title="How can we fill your staffing needs?" copy="Share the requirement, timeline, and operating context. We will connect you with the right talent or technology specialist." image={heroImage} />

  <section class="section" id="contact-form-anchor">
    <div class="shell contact-grid">
      <div data-reveal>
        <p class="eyebrow">Get in touch</p>
        <h2>Let's move the work forward.</h2>
        <p class="lead">TCI supports organizations across the United States and globally with temporary staffing, direct hire, contingent recruiting, total talent, and technology services.</p>
        <dl class="contact-details">
          <div><dt>Email</dt><dd><a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a></dd></div>
          <div><dt>Phone</dt><dd><a href={`tel:${contactInfo.deskTel}`}>Desk {contactInfo.desk}</a><br /><a href={`tel:${contactInfo.mobileTel}`}>Mobile {contactInfo.mobile}</a><br /><small>{contactInfo.hours}</small></dd></div>
          <div><dt>Talent database</dt><dd>500,000+ pre-vetted IT professionals</dd></div>
        </dl>
      </div>

      <form class="contact-form" action={`https://formsubmit.co/${contactInfo.email}`} method="POST" data-contact-form novalidate data-reveal>
        <input type="hidden" name="_subject" value="New enquiry from The Career Insights website" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value="https://thecareerinsights.com/contact?sent=true" />
        <div class="form-row">
          <label><span>Name</span><input type="text" name="name" autocomplete="name" required /></label>
          <label><span>Work email</span><input type="email" name="email" autocomplete="email" required /></label>
        </div>
        <label><span>What are you exploring?</span>
          <select name="interest">
            <option>Recruitment Process Outsourcing</option>
            <option>Contingent Workforce</option>
            <option>Total Talent Solutions</option>
            <option>Technology Services</option>
            <option>Career Guidance</option>
            <option>University or Public Sector Program</option>
          </select>
        </label>
        <label><span>Tell us about the requirement</span><textarea name="message" rows="6" required></textarea></label>
        <div class="form-submit">
          <p data-form-status aria-live="polite">We usually respond within two business days.</p>
          <button class="button button-red" type="submit">Send request <Icon name="arrow" /></button>
        </div>
      </form>
    </div>
  </section>

  <section class="section section-gray">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Visit us</p><h2>Two locations. One connected team.</h2></div>
        <p>Our United States and India teams support clients, candidates, and delivery programs across regions and time zones.</p>
      </div>
      <div class="office-grid">
        <article data-reveal>
          <span>United States</span>
          <h3>{contactInfo.usAddress[0]}</h3>
          <p>{contactInfo.usAddress[1]}</p>
          <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=8+The+Green+Dover+DE+19901" target="_blank" rel="noopener noreferrer">Open in Maps <Icon name="arrow" /></a>
        </article>
        <article data-reveal>
          <span>India</span>
          <h3>{contactInfo.indiaAddress[0]}</h3>
          <p>{contactInfo.indiaAddress[1]}</p>
          <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Hyderabad+Telangana+India" target="_blank" rel="noopener noreferrer">Open in Maps <Icon name="arrow" /></a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
