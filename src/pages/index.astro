---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import IndustryGrid from "../components/IndustryGrid.astro";
import InsightRow from "../components/InsightRow.astro";
import RegionTabs from "../components/RegionTabs.astro";
import Awards from "../components/Awards.astro";
import WhyChooseTrust from "../components/WhyChooseTrust.astro";
import PartnerRail from "../components/PartnerRail.astro";
import StatementReveal from "../components/StatementReveal.astro";
import ProcessFlow from "../components/ProcessFlow.astro";
import CtaBand from "../components/CtaBand.astro";
import { solutionLinks } from "../data/site";
import heroBackground from "../assets/images/site/hero-background.webp";
import advisoryReview from "../assets/images/site/photo-team-meeting.webp";

const stats = [
  { count: 13, suffix: "K+", decimals: 0, label: "Placed at client side" },
  { count: 95, suffix: "%", decimals: 0, label: "Success rate" },
  { count: 4.9, suffix: "", decimals: 1, label: "Average rating" },
  { count: 50, suffix: "K+", decimals: 0, label: "Pre-vetted IT professionals" }
];

const solutionCards = [
  ...solutionLinks.map((item) => ({ title: item.label, copy: item.copy, href: item.href })),
  { title: "Areas of Expertise", copy: "Specialist capability across analytics, AI/ML, SAP, cloud, cybersecurity, and application development.", href: "/services" }
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <Image src={heroBackground} alt="" widths={[768, 1280, 1920, 2560, 3840]} sizes="100vw" format="webp" quality={78} loading="eager" fetchpriority="high" />
      <video data-hero-video muted playsinline preload="none" tabindex="-1">
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    </div>
    <button class="hero-video-toggle" type="button" data-hero-video-toggle aria-label="Pause background video" aria-pressed="false" hidden>
      <svg class="icon-pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="3" height="10" /><rect x="9" y="3" width="3" height="10" /></svg>
      <svg class="icon-play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3v10l8-5z" /></svg>
    </button>
    <div class="shell">
      <div class="hero-copy">
        <p class="eyebrow light">Talent solutions for the pace of modern business</p>
        <h1>Your growth. Our expertise. One talent partner.</h1>
        <p class="hero-lede">Verified talent, flexible workforce programs, and technology expertise that move critical work forward — across the United States and globally.</p>
        <div class="button-row">
          <a class="button button-red" href="/contact">Start a conversation <Icon name="arrow" /></a>
          <a class="button button-light" href="/solutions">Explore solutions</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stat-strip" aria-label="TCI at a glance">
    <div class="shell">
      {stats.map((stat) => (
        <div class="stat">
          <strong><span data-count={stat.count} data-decimals={stat.decimals}>{stat.count.toFixed(stat.decimals)}</span><em>{stat.suffix}</em></strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <StatementReveal />

  <section class="section">
    <div class="shell split">
      <div class="split-copy" data-reveal>
        <p class="eyebrow">Who we are</p>
        <h2>We start with the requirement, not a pile of resumes.</h2>
        <p class="lead">The Career Insights combines targeted database filtering with a stringent verification process, so every shortlist is qualified, certification-ready, and appropriately cleared.</p>
        <p>The result is a faster, more confident path from workforce need to placement — for public, private, and commercial organizations of every size.</p>
        <a class="text-link" href="/about">More about TCI <Icon name="arrow" /></a>
      </div>
      <div class="split-media" data-reveal>
        <div class="media-frame" data-parallax><Image src={advisoryReview} alt="A hiring team reviewing candidate shortlists together" widths={[480, 720, 1000]} sizes="(max-width: 960px) 92vw, 560px" format="webp" quality={80} loading="lazy" /></div>
        <div class="media-badge" data-media-badge>
          <svg class="media-badge-ring" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="27" /><circle class="media-badge-progress" cx="32" cy="32" r="27" pathLength="100" style="--value: 95" /></svg>
          <div>
            <strong>95%</strong>
            <span>Success rate</span>
            <span class="media-badge-rating" aria-label="4.9 out of 5 average rating"><b aria-hidden="true">★★★★★</b> 4.9 average rating</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PartnerRail />

  <section class="section section-gray">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">What we do</p><h2>Talent solutions built around your goals.</h2></div>
        <p>No two organizations hire the same way. We design flexible programs that meet today's need and scale with the business.</p>
      </div>
      <div class="solution-grid">
        {solutionCards.map((card, index) => (
          <a class="solution-card" href={card.href} data-reveal>
            <span class="num">{String(index + 1).padStart(2, "0")}</span>
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
            <span class="text-link">Learn more <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ProcessFlow />

  <section class="section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Why TCI</p><h2>What hiring leaders care about most.</h2></div>
        <p>Five outcomes we design every program around — from the first requisition to the hundredth hire.</p>
      </div>
      <InsightRow />
    </div>
  </section>

  <section class="section section-gray">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Industries</p><h2>Sector context behind every hire.</h2></div>
        <p>We understand the operating landscape behind the job title, then build a talent approach that supports innovation and growth.</p>
      </div>
      <IndustryGrid href="/industries" linkLabel="Explore industries" />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Where we work</p><h2>Two offices. One connected team.</h2></div>
        <p>Our United States and India teams support clients, candidates, and delivery programs across regions and time zones.</p>
      </div>
      <RegionTabs />
    </div>
  </section>

  <Awards />

  <WhyChooseTrust />

  <CtaBand />
</BaseLayout>
