---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import TrustBadge from "../components/TrustBadge.astro";
import PartnerRail from "../components/PartnerRail.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { coreValues } from "../data/site";
import heroImage from "../assets/images/site/photo-corporate-hallway.png";
import photo from "../assets/images/site/photo-colleagues.webp";
---

<BaseLayout title="About The Career Insights" description="Learn how The Career Insights supports organizations, professionals, small businesses, cleared talent, and military veterans.">
  <PageHero eyebrow="About us" title="We make the path from workforce need to proven capability clearer." copy="Practical talent systems for public, private, and commercial organizations across the United States and globally." image={heroImage} />

  <section class="section">
    <div class="shell split">
      <div class="split-copy" data-reveal>
        <p class="eyebrow">Who we are</p>
        <h2>Our methodology starts with the requirement.</h2>
        <p class="lead">Not a generic pool of resumes.</p>
        <p>We use targeted database filtering and a stringent verification process to present qualified candidates who are fully vetted for relevant certifications and clearances. The result is a faster, more confident path to placement.</p>
        <p>We also support professionals at every stage of their career through personalized guidance, expert insight, skill development, and ongoing support.</p>
        <a class="text-link" href="/contact">Need staffing assistance? <Icon name="arrow" /></a>
      </div>
      <div class="split-media" data-reveal>
        <div class="media-frame" data-parallax><Image src={photo} alt="Colleagues discussing work around a desk" widths={[480, 720, 1000]} sizes="(max-width: 960px) 92vw, 560px" format="webp" quality={80} loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Overview</p><h2>Affordable talent access with specialist reach.</h2></div>
        <p>TCI supports temporary and direct hire across public, private, and commercial sectors, with a focus on helping small businesses grow through practical hiring solutions.</p>
      </div>
      <div class="pillars">
        <article data-reveal><strong>Public</strong><p>Government, contractors, cleared roles, and public programs.</p></article>
        <article data-reveal><strong>Private</strong><p>Technology, finance, healthcare, operations, and professional functions.</p></article>
        <article data-reveal><strong>Commercial</strong><p>Direct hire, contingent recruiting, staffing, and project delivery.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Core services</p><h2>Where we make the biggest difference.</h2></div>
      </div>
      <div class="benefit-grid">
        {coreValues.map((value) => <article data-reveal><h3>{value.title}</h3><p>{value.copy}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="shell split">
      <div class="split-copy" data-reveal>
        <p class="eyebrow">Military veterans</p>
        <h2>Supporting the transition back into the workforce.</h2>
        <p class="lead">We help military veterans find meaningful employment while helping employers meet veteran hiring goals.</p>
        <p>Our staffing areas include information technology, cybersecurity, healthcare, finance, executive search, and program and project management. TCI is committed to equal opportunity employment for qualified people regardless of sex, race, religion, ethnic origin, or any other legally protected status.</p>
      </div>
      <div class="trust-badge-col" data-reveal="scale"><TrustBadge /></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="pillars">
        <article id="careers" data-reveal><strong>Careers</strong><p>Join a team focused on practical impact, trusted delivery, and better workforce outcomes.</p><a class="text-link" href="/contact">Explore careers <Icon name="arrow" /></a></article>
        <article data-reveal><strong>Partners</strong><p>Extend delivery through aligned technology, training, recruiting, and implementation partnerships.</p><a class="text-link" href="/contact">Become a partner <Icon name="arrow" /></a></article>
        <article id="clients" data-reveal><strong>Clients</strong><p>Work with a responsive team built around your goals, constraints, and operating environment.</p><a class="text-link" href="/contact">Talk to our team <Icon name="arrow" /></a></article>
      </div>
    </div>
  </section>

  <PartnerRail title="Partners who extend our delivery." />

  <CtaBand />
</BaseLayout>
