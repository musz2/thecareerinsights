---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SolutionPage from "../../components/SolutionPage.astro";
import heroImage from "../../assets/images/site/photo-talent-team.webp";
import photo from "../../assets/images/site/photo-creative-team.webp";
import icon0 from "../../assets/images/site/insight-quality.webp";
import icon1 from "../../assets/images/site/insight-intelligence.webp";
import icon2 from "../../assets/images/site/insight-speed.webp";
import icon3 from "../../assets/images/site/insight-brand.webp";
const bullets = ["End-to-end internal and external candidate pipelines", "Permanent, contract, temporary, and internal talent", "Expert definition of the ideal candidate profile", "Streamlined temporary-to-permanent transitions", "Dedicated talent pools for critical roles"];
const benefits = [{ title: "Talent Pool Development", copy: "Build and maintain dedicated sourcing plans and talent communities for critical roles.", icon: icon0 }, { title: "Data-Driven Decisions", copy: "Use market analytics and workforce intelligence to improve sourcing decisions.", icon: icon1 }, { title: "Centralized Management", copy: "Bring sourcing, interviewing, tracking, selection, and onboarding into one operating view.", icon: icon2 }, { title: "Internal Mobility", copy: "Connect existing capability with emerging opportunities across the organization.", icon: icon3 }];
---
<BaseLayout title="Total Talent Solutions | The Career Insights" description="Integrated talent management across permanent, temporary, contract, and internal teams."><SolutionPage title="Total Talent Solutions" subtitle="One platform. Every talent type. Seamless workforce management." intro="Comprehensive solutions designed for every talent category." body="TCI provides a unified framework for strategic workforce planning across permanent, temporary, contract, and internal placements. We improve sourcing effectiveness, support internal mobility, and simplify the transition from temporary to permanent employment." bullets={bullets} stat="Total visibility" statLabel="A connected view of permanent, contingent, temporary, and internal talent." benefits={benefits} hero={heroImage} photo={photo} photoAlt="A team mapping out a workforce plan" /></BaseLayout>
