---
import "@fontsource-variable/montserrat";
import "@fontsource-variable/open-sans";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AIAssistant from "../components/AIAssistant.astro";
import Icon from "../components/Icon.astro";
import PageLoader from "../components/PageLoader.astro";
import { contactInfo } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /* "light" keeps the header solid from the top (pages without a dark hero) */
  header?: "overlay" | "light";
}

const {
  title = "The Career Insights | Talent Solutions and Technology Services",
  description = "Recruitment, contingent workforce, total talent, and technology services for organizations across the United States and globally.",
  header = "overlay"
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL("https://thecareerinsights.com")).origin;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://thecareerinsights.com").href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteOrigin}/#organization`,
  name: "The Career Insights",
  url: siteOrigin,
  logo: `${siteOrigin}/favicon.svg`,
  image: `${siteOrigin}/og-image.jpg`,
  description,
  email: contactInfo.email,
  telephone: contactInfo.desk,
  address: [
    {
      "@type": "PostalAddress",
      streetAddress: contactInfo.usAddress[0],
      addressLocality: "Dover",
      addressRegion: "DE",
      postalCode: "19901",
      addressCountry: "US"
    },
    {
      "@type": "PostalAddress",
      streetAddress: contactInfo.indiaAddress.join(", "),
      addressLocality: "Hyderabad",
      addressRegion: "Telangana",
      addressCountry: "IN"
    }
  ],
  areaServed: ["United States", "India", "Global"]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Career Insights" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-image.jpg", Astro.site ?? "https://thecareerinsights.com").href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Career Insights — talent solutions and technology services" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="application-name" content="The Career Insights" />
    <meta name="apple-mobile-web-app-title" content="TCI" />
    <title>{title}</title>
    <script is:inline>
      /* Content starts hidden for scroll reveals only while JS can reveal it:
         if the motion bundle hasn't booted within 4s, show everything. */
      (function (root) {
        root.classList.add("js");
        setTimeout(function () { if (!root.classList.contains("motion-ready")) root.classList.remove("js"); }, 4000);

        /* Logo overlay: full intro on the homepage, a quicker run after an
           internal page switch. Skipped for reduced motion. Never left up
           longer than 6s even if scripts fail. */
        var fromNav = false;
        try { fromNav = sessionStorage.getItem("tci-nav") === "1"; sessionStorage.removeItem("tci-nav"); } catch (e) {}
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduce && (fromNav || location.pathname === "/")) {
          root.classList.add("loader-on", fromNav ? "loader-quick" : "loader-full");
          setTimeout(function () { root.classList.remove("loader-on", "loader-quick", "loader-full"); }, 6000);
        }
      })(document.documentElement);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body id="top" data-header={header}>
    <PageLoader />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <a class="back-to-top" href="#top" aria-label="Back to top"><Icon name="up" /></a>
    <AIAssistant />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
